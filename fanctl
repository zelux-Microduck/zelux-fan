class FanBusyError(RuntimeError):
    """The requested operation conflicts with or cannot release a hardware resource."""


# ================================================================ 温控纯函数
def clamp_pct(pct: Any, lo: int = 0, hi: int = 100) -> int:
    """面板/命令行输入什么都能进来（null/-1/1200），这里统一夹紧，别让 duty 溢出。"""
    try:
        v = int(round(float(pct)))
    except (TypeError, ValueError):
        return DEFAULT_PCT
    return lo if v < lo else hi if v > hi else v


def pct_to_duty(pct: Any, period_ns: int) -> int:
    return int(round(clamp_pct(pct) / 100.0 * max(1, period_ns)))


def rpm_from_hz(hz: float, pulses_per_rev: int = PULSES_PER_REV) -> int:
    """4pin 风扇一般每转 2 个脉冲。ppr 配错时读数会整体偏 2 倍，先看这个参数。"""
    ppr = max(1, int(pulses_per_rev))
    return max(0, int(round(max(0.0, float(hz)) * 60.0 / ppr)))


def normalize_curve(curve: Any, default: list[list[int]]) -> list[list[int]]:
    """校验温控阶梯：[[温度, 百分比], ...]，按温度升序、夹紧、同温度去重。

    错的曲线比没有曲线更糟（比如温度写反了会导致越热越慢），所以宁可回退默认值。
    """
    rows: list[list[int]] = []
    if isinstance(curve, (list, tuple)):
        for item in curve:
            try:
                t, p = float(item[0]), int(item[1])
            except (TypeError, ValueError, IndexError):
                continue
            if not (-10 <= t <= 120):
                continue
            rows.append([int(round(t)), clamp_pct(p)])
    if not rows:
        return [list(r) for r in default]
    rows.sort(key=lambda r: r[0])
    out: list[list[int]] = []
    for t, p in rows:                       # 同一温度只留最后一条，避免二义
        if out and out[-1][0] == t:
            out[-1] = [t, p]
        else:
            out.append([t, p])
    return out


def curve_pct(temp: float | None, curve: list[list[int]], default: int = DEFAULT_PCT) -> int:
    """阶梯温控：温度 >= 台阶温度就套那一档，都不满足用默认值。

    默认 60% 而不是 0%：停转会让主控在重负载下十几秒就上 80℃，
    而且风扇重启时的"咯"一下比常转更烦人。
    """
    pct = clamp_pct(default)
    if temp is None:
        return pct
    for t, p in curve:
        if float(temp) >= t:
            pct = p
    return pct


def read_max_temp() -> float | None:
    """读所有 thermal_zone，返回最高温度（℃）。读不到返回 None，不猜。"""
    best: float | None = None
    if not THERMAL_ROOT.exists():
        return None
    for zone in THERMAL_ROOT.glob("thermal_zone*"):
        try:
            raw = int((zone / "temp").read_text("ascii").strip())
        except (OSError, ValueError):
            continue
        val = raw / 1000.0
        if 0 < val < MAX_TEMP_SANE and (best is None or val > best):
            best = val
    return round(best, 1) if best is not None else None


